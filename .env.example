# SubForge headless automation configuration (OPTIONAL).
# The primary configuration path is the TUI (Settings menu), stored at
# ~/.config/subforge/config.json. Use this file ONLY for headless runs.
# Copy to .env and fill in values. NEVER commit .env.

# --- Transcription ---
# TRANSCRIPTION_PROVIDER=local          # local | remote | openai
# TRANSCRIPTION_MODEL=large-v3
# TRANSCRIPTION_DEVICE=auto
# TRANSCRIPTION_COMPUTE_TYPE=auto

# --- Translation ---
# TRANSLATION_PROVIDER=openai-compatible
# TRANSLATION_BASE_URL=http://localhost:1234/v1   # LM Studio / Ollama
TRANSLATION_API_KEY=
TRANSLATION_MODEL=
# TRANSLATION_BATCH_SIZE=5
